// Prisma schema
// Run: pnpm dlx prisma generate && pnpm dlx prisma migrate dev --name init 修改 schema 后，需要运行 prisma generate 和 prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Thread {
  id        String   @id @default(uuid())
  title     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  threads           Thread[]
  resumes           Resume[]
  jobDescriptions   JobDescription[]
  jobApplications   JobApplication[]
  interviewSessions InterviewSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model MCPServer {
  id           String        @id @default(uuid())
  name         String        @unique
  type         MCPServerType
  enabled      Boolean       @default(true)
  // For stdio servers
  command      String?
  args         Json?
  env          Json?
  // For http servers
  url          String?
  headers      Json?
  // OAuth fields (for http servers)
  requiresAuth Boolean?      @default(false)
  authTokens   Json? // OAuthTokens: { access_token, refresh_token, expires_at, token_type, scope }
  clientInfo   Json? // OAuthClientInformation: { client_id, client_secret, ... }
  codeVerifier String? // PKCE code verifier for ongoing OAuth flow
  oauthStatus  String?       @default("UNKNOWN") // UNKNOWN | NOT_REQUIRED | REQUIRED | CONNECTED | EXPIRED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model JobApplication {
  id               String          @id @default(uuid())
  company          String
  position         String
  status           String          @default("待投递")
  matchScore       Int             @default(75)
  nextAction       String?
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, createdAt])
}

model JobDescription {
  id           String           @id @default(uuid())
  title        String?
  content      String
  matchScore   Int
  level        String
  strengths    Json
  weaknesses   Json
  suggestions  Json
  applications JobApplication[]
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, createdAt])
}

model Resume {
  id                String   @id @default(uuid())
  fileName          String
  score             Int
  targetRole        String
  education         String
  experienceLevel   String
  skills            Json
  projectHighlights Json
  suggestions       Json
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model InterviewSession {
  id         String   @id @default(uuid())
  questionId String
  question   String
  answer     String
  score      Int
  dimensions Json
  suggestion String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

enum MCPServerType {
  stdio
  http
}
